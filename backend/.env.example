ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Netscape cookies.txt contents (Render secret). Prefer this over committing a file.
# YOUTUBE_COOKIES=# Netscape HTTP Cookie File\n.youtube.com	TRUE	/	TRUE	0	LOGIN_INFO	...

# Or a path to an existing cookies.txt inside the container
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt

# Optional residential/mobile HTTP(S) proxy
# YOUTUBE_PROXY=http://user:pass@host:port

# TLS browser impersonation (requires curl_cffi). Set off to disable.
# YOUTUBE_IMPERSONATE=chrome
