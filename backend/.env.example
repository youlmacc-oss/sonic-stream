ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Public /health stays lightweight. Admin diagnostics require this token in production.
# ADMIN_TOKEN=change-me

# Cookie mode: anonymous_first | always | never
YOUTUBE_COOKIE_MODE=anonymous_first

# Netscape cookies.txt contents (do not commit real cookies)
# YOUTUBE_COOKIES=# Netscape HTTP Cookie File\n.youtube.com	TRUE	/	TRUE	0	LOGIN_INFO	...

# Or a path to an existing cookies.txt
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt

# Optional single proxy (also used as route alias "proxy")
# YOUTUBE_PROXY=http://user:pass@host:port

# Named routes. Aliases only appear in logs. Values stay in env.
YOUTUBE_ALLOW_DIRECT=true
# YOUTUBE_ROUTES=home,mobile
# YOUTUBE_ROUTE_home=http://user:pass@home-proxy:8080
# YOUTUBE_ROUTE_mobile=http://user:pass@mobile-proxy:8080

# TLS impersonation (requires curl_cffi). Off if it misbehaves.
YOUTUBE_IMPERSONATE=chrome

# Diagnostic only. Does not claim to bypass blocks.
# YOUTUBE_IP_MODE=ipv4

# Optional bgutil HTTP provider. Plugin generates per-video tokens; do not paste a static PO Token.
# YOUTUBE_POT_BASE_URL=http://127.0.0.1:4416

MAX_CONCURRENT_DOWNLOADS=1
MAX_DOWNLOAD_QUEUE=8
MAX_QUEUE_WAIT_SECONDS=180
MAX_JOB_ATTEMPTS=4
MAX_RATE_LIMIT_WAITS=2
MAX_ROUTE_SWITCHES=1
JOB_TIMEOUT_SECONDS=720
JOB_DONE_TTL_MINUTES=10
JOB_ACTIVE_TTL_MINUTES=30

# Structured event logs. Single process only. Do not dump secrets.
# SONIC_LOG_DIR=C:\AICODING\sonic-stream\backend\logs
LOG_ROTATE_MAX_BYTES=5000000
LOG_RETAIN_DAYS=14
LOG_MAX_TOTAL_BYTES=50000000
LOG_QUEUE_SIZE=1000

# Optional durable copy. Without this, redeploy can drop local logs.
# LOG_BACKUP_DIR=C:\sonic-stream-log-backup
